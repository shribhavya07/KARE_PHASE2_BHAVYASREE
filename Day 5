//palindrome number

import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int temp = n;
        int d,ans=0;
        while(n!=0)
        {
            d=n%10;
            ans=ans*10+d;
            n=n/10;
        }
        if(temp==ans)
        System.out.println("Palindrome Number");
        else
        System.out.println("Not a Palindrome Number");
    }
}
