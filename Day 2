import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner obj = new Scanner(System.in);
        int a,b;
        a = obj.nextInt();
        b = obj.nextInt();
        if(a==b){
            System.out.println(a + " And " + b + " are equal");
        }
        else{
            System.out.println(a + " And " + b + " are not equal");
        }
    }
}





