class CircularSingly {

    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    static Node head = null;

    // Insert at end
    static void insert(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            newNode.next = head;
            return;
        }

        Node temp = head;

        while (temp.next != head) {
            temp = temp.next;
        }

        temp.next = newNode;
        newNode.next = head;
    }

    // Display
    static void display() {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        Node temp = head;

        do {
            System.out.print(temp.data + " ");
            temp = temp.next;
        } while (temp != head);

        System.out.println();
    }

    // 1. Sum of elements
    static int sum() {
        if (head == null)
            return 0;

        int sum = 0;
        Node temp = head;

        do {
            sum += temp.data;
            temp = temp.next;
        } while (temp != head);

        return sum;
    }

    // 2. Sort elements
    static void sort() {
        if (head == null)
            return;

        Node i = head;

        do {
            Node j = i.next;

            while (j != head) {

                if (i.data > j.data) {
                    int temp = i.data;
                    i.data = j.data;
                    j.data = temp;
                }

                j = j.next;
            }

            i = i.next;

        } while (i.next != head);
    }

    // 3. Maximum element
    static int maximum() {
        if (head == null)
            return -1;

        int max = head.data;
        Node temp = head.next;

        while (temp != head) {
            if (temp.data > max) {
                max = temp.data;
            }

            temp = temp.next;
        }

        return max;
    }

    // 4. Insert element at a given position
    static void insertAtPosition(int data, int position) {

        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            newNode.next = head;
            return;
        }

        // Insert at first position
        if (position == 1) {

            Node temp = head;

            while (temp.next != head) {
                temp = temp.next;
            }

            newNode.next = head;
            head = newNode;
            temp.next = head;

            return;
        }

        Node temp = head;

        for (int i = 1; i < position - 1; i++) {
            temp = temp.next;

            if (temp == head) {
                System.out.println("Invalid position");
                return;
            }
        }

        newNode.next = temp.next;
        temp.next = newNode;
    }

    // 5. Reverse elements
    static void reverse() {

        if (head == null || head.next == head)
            return;

        Node prev = null;
        Node current = head;
        Node next;

        Node last = head;

        while (last.next != head) {
            last = last.next;
        }

        do {
            next = current.next;
            current.next = prev;
            prev = current;
            current = next;

        } while (current != head);

        head.next = prev;
        head = prev;
    }

    public static void main(String[] args) {

        insert(40);
        insert(10);
        insert(30);
        insert(20);

        System.out.println("Original list:");
        display();

        System.out.println("Sum = " + sum());

        System.out.println("Maximum = " + maximum());

        sort();

        System.out.println("After sorting:");
        display();

        insertAtPosition(25, 3);

        System.out.println("After insertion:");
        display();

        reverse();

        System.out.println("After reversing:");
        display();
    }
}
