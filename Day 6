import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc= new Scanner(System.in);
	    int n = sc.nextInt();
	    int  temp=n,d,sum=0;
	    while(n!=0){
	        d=n%10;
	        sum=sum+(d*d*d);
	        n=n/10;
	    }
	    if(sum==temp){
	        System.out.println("amstrong");
	    }else{
	        System.out.println(" not amstrong");
	        
	    }   
	}
}

